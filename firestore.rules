rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
             request.auth.uid == "qdeDtBfWIKNgWVjoUWHR3W3L7oa2" ||
             ("email" in request.auth.token && request.auth.token.email.toLowerCase() == "upfrontretaile@gmail.com")
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function hasPermission(permissionName) {
      return isSignedIn() && (
        isSuperAdmin() || (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          permissionName in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.permissions
        )
      );
    }

    function isApprovedSeller() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/sellers/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data.status == "approved";
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Products
    match /products/{productId} {
      function isValidProduct(data) {
        return data.name is string && data.name.size() > 0 &&
               data.price is number && data.price >= 0 &&
               data.category is string &&
               data.stock is number && data.stock >= 0;
      }

      allow read: if true;
      allow create: if (hasPermission("manage_inventory") || (isApprovedSeller() && incoming().sellerId == request.auth.uid)) && isValidProduct(incoming()) && isValidId(productId);
      allow update: if (hasPermission("manage_inventory") && isValidProduct(incoming())) ||
                    (isApprovedSeller() && existing().sellerId == request.auth.uid && incoming().sellerId == request.auth.uid && isValidProduct(incoming())) ||
                    (isVerified() && incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'reviewCount', 'stock']));
      allow delete: if hasPermission("manage_inventory") || (isApprovedSeller() && existing().sellerId == request.auth.uid);
    }

    // Pending Products
    match /pending_products/{pendingId} {
      function isValidPendingProduct(data) {
        return data.name is string && data.name.size() > 0 &&
               data.price is number && data.price >= 0 &&
               data.category is string &&
               data.stock is number && data.stock >= 0 &&
               data.sellerId is string &&
               data.approvalStatus in ['pending', 'approved', 'rejected'];
      }

      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.sellerId == request.auth.uid));
      allow create: if (isAdmin() || (isSignedIn() && incoming().sellerId == request.auth.uid)) && isValidPendingProduct(incoming()) && isValidId(pendingId);
      allow update: if (isAdmin() && isValidPendingProduct(incoming())) ||
                    (isSignedIn() && existing().sellerId == request.auth.uid && incoming().sellerId == request.auth.uid && isValidPendingProduct(incoming()));
      allow delete: if isAdmin() || (isSignedIn() && existing().sellerId == request.auth.uid);
    }

    // Orders
    match /orders/{orderId} {
      function isValidOrder(data) {
        return data.userId is string && data.userId == request.auth.uid &&
               data.items is list && data.items.size() > 0 &&
               data.totalAmount is number && data.totalAmount >= 0 &&
               data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'];
      }

      allow read: if hasPermission("manage_orders") || (isSignedIn() && (existing().userId == request.auth.uid || request.auth.uid in existing().sellerIds));
      allow create: if isVerified() && isValidOrder(incoming()) && isValidId(orderId);
      allow update: if hasPermission("manage_orders") || (isSignedIn() && existing().userId == request.auth.uid && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['status']) && 
                    incoming().status == 'cancelled' && existing().status == 'pending');
      allow delete: if hasPermission("manage_orders") || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // Users
    match /users/{userId} {
      function isValidProfile(data) {
        return data.email == null || (data.email is string && data.email.size() > 0);
      }

      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidProfile(incoming());
      allow update: if isOwner(userId) && isValidProfile(incoming());
      allow delete: if hasPermission("manage_users");
    }

    // Carts (for Abandoned Cart Cloud Functions support & Cross-device synchronizations)
    match /carts/{userId} {
      function isValidCart(data) {
        return data.userId == request.auth.uid &&
               data.items is list &&
               (data.email == null || (data.email is string && data.email.size() <= 256)) &&
               (data.isAbandonedEmailSent == null || data.isAbandonedEmailSent is bool);
      }

      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidCart(incoming());
      allow update: if isOwner(userId) && isValidCart(incoming());
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Reviews
    match /reviews/{reviewId} {
      function isValidReview(data) {
        return data.productId is string && data.userId == request.auth.uid &&
               data.rating is int && data.rating >= 1 && data.rating <= 5;
      }

      allow read: if true;
      allow create: if isSignedIn() && isValidReview(incoming()) && isValidId(reviewId);
      allow update: if isOwner(existing().userId) && isValidReview(incoming());
      allow delete: if isAdmin() || isOwner(existing().userId);
    }

    // Blog
    match /blog/{postId} {
      allow read: if true;
      allow write: if hasPermission("manage_blogs");
    }

    // Comments
    match /comments/{commentId} {
      function isValidComment(data) {
        return data.postId is string && data.postId.size() > 0 &&
               data.userId == request.auth.uid &&
               data.userName is string && data.userName.size() > 0 &&
               data.content is string && data.content.size() > 0 && data.content.size() <= 2000 &&
               data.replies is list;
      }

      allow read: if true;
      allow create: if isSignedIn() && isValidComment(incoming()) && isValidId(commentId);
      allow update: if isSignedIn() && (
        (isOwner(existing().userId) && isValidComment(incoming())) ||
        (incoming().postId == existing().postId && 
         incoming().userId == existing().userId && 
         incoming().userName == existing().userName && 
         incoming().content == existing().content &&
         incoming().replies is list && 
         incoming().replies.size() > existing().replies.size())
      );
      allow delete: if isAdmin() || isOwner(existing().userId);
    }

    // Support Tickets
    match /support_tickets/{ticketId} {
      function isValidTicket(data) {
        return data.email is string && data.email.size() > 0 &&
               data.subject in ["Technical Support", "Billing/Invoices", "Order Status", "General Inquiry"] &&
               data.message is string && data.message.trim().size() > 0 &&
               data.status in ["open", "in-progress", "resolved", "closed"];
      }

      allow create: if isSignedIn() && isValidTicket(incoming()) && (incoming().userId == null || incoming().userId == request.auth.uid);
      allow read: if hasPermission("manage_inbox") || (isSignedIn() && (resource == null || existing().userId == request.auth.uid));
      allow update: if hasPermission("manage_inbox") || (
                      isSignedIn() && existing().userId == request.auth.uid &&
                      incoming().userId == existing().userId &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['replies', 'unreadCountAdmin', 'unreadCountClient', 'updatedAt', 'status'])
                    );
      allow delete: if hasPermission("manage_inbox") || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // Price Drop Alerts
    match /price_drop_alerts/{alertId} {
      function isValidAlert(data) {
        return data.productId is string && data.productId.size() > 0 &&
               data.productName is string && data.productName.size() > 0 &&
               data.email is string && data.email.size() > 0 &&
               data.targetPrice is number && data.targetPrice >= 0 &&
               data.status in ["active", "triggered"];
      }

      allow create: if isValidAlert(incoming()) && isValidId(alertId);
      allow read, update, delete: if hasPermission("manage_inventory");
    }

    // Newsletter Subscribers
    match /newsletter_subscribers/{subscriberId} {
      function isValidSubscriber(data) {
        return data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
               data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 50 &&
               (data.userId == null || (data.userId is string && data.userId.size() <= 128));
      }

      allow create: if isValidSubscriber(incoming()) && isValidId(subscriberId);
      allow read, update, delete: if hasPermission("manage_inbox");
    }

    // Settings
    match /settings/{settingId} {
      function isValidSettings(data) {
        return (data.heroImageUrl == null || (data.heroImageUrl is string && data.heroImageUrl.size() <= 2000000)) &&
               (data.heroBadgeText == null || (data.heroBadgeText is string && data.heroBadgeText.size() <= 100)) &&
               (data.heroHeadingText == null || (data.heroHeadingText is string && data.heroHeadingText.size() <= 150)) &&
               (data.googleMapsLink == null || (data.googleMapsLink is string && data.googleMapsLink.size() <= 2000)) &&
               (data.googleMapsLinks == null || (data.googleMapsLinks is list && data.googleMapsLinks.size() <= 30)) &&
               (data.updatedBy == null || (data.updatedBy is string && data.updatedBy.size() <= 200));
      }

      allow read: if true;
      allow write: if hasPermission("manage_settings") && isValidSettings(incoming()) && isValidId(settingId);
    }

    // Job Offers
    match /job_offers/{jobId} {
      function isValidJobOffer(data) {
        return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
               data.department is string && data.department.size() > 0 &&
               data.location is string && data.location.size() > 0 &&
               data.type is string &&
               data.description is string && data.description.size() > 0;
      }

      allow read: if true;
      allow create: if hasPermission("manage_careers") && isValidJobOffer(incoming()) && isValidId(jobId);
      allow update: if hasPermission("manage_careers") && isValidJobOffer(incoming());
      allow delete: if hasPermission("manage_careers");
    }

    // Job Applications
    match /job_applications/{applicationId} {
      function isValidApplication(data) {
        return data.jobId is string && data.jobId.size() > 0 &&
               data.jobTitle is string && data.jobTitle.size() > 0 &&
               data.userId == request.auth.uid &&
               data.applicantName is string && data.applicantName.size() > 0 && data.applicantName.size() <= 200 &&
               data.applicantEmail is string && data.applicantEmail.size() > 0 && data.applicantEmail.size() <= 200 &&
               data.applicantPhone is string && data.applicantPhone.size() > 0 && data.applicantPhone.size() <= 50 &&
               data.resumeDetails is string && data.resumeDetails.size() > 0 && data.resumeDetails.size() <= 1000000 &&
               data.status in ['pending', 'reviewed', 'shortlisted', 'rejected'];
      }

      allow create: if isSignedIn() && isValidApplication(incoming()) && isValidId(applicationId);
      allow read: if hasPermission("manage_careers") || (isSignedIn() && (resource == null || existing().userId == request.auth.uid));
      allow update: if hasPermission("manage_careers") || (isSignedIn() && existing().userId == request.auth.uid && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['status']) && 
                    incoming().status == 'cancelled');
      allow delete: if hasPermission("manage_careers") || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // Roles
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Admin Invitations
    match /admin_invitations/{invitationId} {
      function isValidInvitation(data) {
        return data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
               data.roleId is string && data.roleId.size() <= 100 &&
               data.roleName is string && data.roleName.size() <= 100 &&
               data.permissions is list &&
               data.status in ['pending', 'accepted'];
      }
      allow read: if isSignedIn() && (isSuperAdmin() || resource == null || ("email" in request.auth.token && existing().email.toLowerCase() == request.auth.token.email.toLowerCase()));
      allow create, update: if isSuperAdmin() && isValidInvitation(incoming()) && isValidId(invitationId);
      allow delete: if isSuperAdmin();
    }

    // Admins
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(logId);
      allow update, delete: if false;
    }

    // Marketing Campaigns
    match /marketing_campaigns/{campaignId} {
      allow read, write: if isAdmin();
    }

    // Marketing Banners
    match /marketing_banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Notifications
    match /users/{userId}/notifications/{notificationId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if isAdmin() || isOwner(userId);
    }

    // Marketplace Sellers
    match /sellers/{sellerId} {
      function isValidSeller(data) {
        return data.shopName is string && data.shopName.size() > 0 && data.shopName.size() <= 200 &&
               data.phone is string && data.phone.size() > 0 &&
               data.location is string && data.location.size() > 0 &&
               data.status in ['pending', 'approved', 'rejected'];
      }

      allow read: if true;
      allow create: if isOwner(sellerId) && isValidSeller(incoming());
      allow update: if (isOwner(sellerId) && isValidSeller(incoming())) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
