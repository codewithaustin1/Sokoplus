{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A product available for sale in the e-commerce store.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Product name" },
        "description": { "type": "string", "description": "Full description of the product" },
        "price": { "type": "number", "description": "Price in KES" },
        "category": { "type": "string", "description": "Product category" },
        "images": { "type": "array", "description": "List of image URLs" },
        "stock": { "type": "integer", "description": "Available inventory" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "rating": { "type": "number", "description": "Average rating" },
        "reviewCount": { "type": "integer", "description": "Number of reviews" },
        "active": { "type": "boolean", "description": "Active status of the product" },
        "artisan": { "type": "string", "description": "The creative artisan or craftsperson behind the product" },
        "buyingPrice": { "type": "number", "description": "The internal buying cost from creator/supplier for profit calculation" },
        "sellerId": { "type": "string", "description": "The UID of the registered artisan/merchant seller" },
        "sellerName": { "type": "string", "description": "The marketplace shop name of the seller" },
        "approvalStatus": { "type": "string", "enum": ["pending", "approved", "rejected"], "description": "Artisan submission layout review status" },
        "rejectionReason": { "type": "string", "description": "The direct corrective details given by the admin when declining" },
        "originalProductId": { "type": "string", "description": "For revised list editing, references the live product document identifier parent" },
        "isPending": { "type": "boolean", "description": "Helper indicator tracking if item represents a submission draft" }
      },
      "required": ["name", "price", "category", "stock"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order containing items and payment details.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "ID of the customer" },
        "items": { "type": "array", "description": "List of items in the order" },
        "totalAmount": { "type": "number", "description": "Final price paid" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled"], "description": "Current state of the order" },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "paid", "failed"], "description": "Payment authorization status" },
        "paymentReference": { "type": "string", "description": "Paystack transaction reference" },
        "shippingAddress": { "type": "object", "description": "Detailed shipping destination" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items", "totalAmount", "status"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Social and preference data for a registered customer.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "loyaltyPoints": { "type": "integer" },
        "wishlist": { "type": "array" },
        "theme": { "type": "string", "enum": ["light", "dark"] },
        "photoURL": { "type": "string", "description": "Base64 encoded or URL path to user profile and avatar image" },
        "twoFactorEnabled": { "type": "boolean", "description": "Whether multi-factor TOTP authentication is enabled" },
        "twoFactorSecret": { "type": "string", "description": "The Base32 secret key used to generate/verify TOTP codes" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer feedback on a specific product.",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "integer" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userId", "rating"]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "Content marketing article.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "author": { "type": "string" },
        "image": { "type": "string" },
        "tags": { "type": "array" },
        "publishedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "author"]
    },
    "Comment": {
      "title": "Comment",
      "description": "A comment or reply on a specific blog post.",
      "type": "object",
      "properties": {
        "postId": { "type": "string", "description": "ID of the associated blog post" },
        "userId": { "type": "string", "description": "User identifier who crafted the comment" },
        "userName": { "type": "string", "description": "Display name of the author" },
        "content": { "type": "string", "description": "Markdown comment text content" },
        "createdAt": { "type": "string", "format": "date-time" },
        "replies": {
          "type": "array",
          "description": "An array of responses containing id, userId, userName, content, and createdAt"
        }
      },
      "required": ["postId", "userId", "userName", "content", "replies"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer support request.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "subject": { "type": "string", "enum": ["Technical Support", "Billing/Invoices", "Order Status", "General Inquiry"] },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "in-progress", "resolved", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "subject", "message", "status"]
    },
    "HomepageSettings": {
      "title": "HomepageSettings",
      "description": "Customizable homepage settings like custom hero images.",
      "type": "object",
      "properties": {
        "heroImageUrl": { "type": "string" },
        "heroImageUrls": {
          "type": "array",
          "items": { "type": "string" }
        },
        "heroBadgeText": { "type": "string" },
        "heroHeadingText": { "type": "string" },
        "googleMapsLink": { "type": "string" },
        "googleMapsLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string" }
            },
            "required": ["name", "url"]
          }
        },
        "brandLogoUrl": { "type": "string" },
        "faviconUrl": { "type": "string" },
        "seoTitle": { "type": "string" },
        "seoDescription": { "type": "string" },
        "seoImage": { "type": "string" },
        "featuredCollections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "imageUrl": { "type": "string" },
              "category": { "type": "string" }
            },
            "required": ["title", "imageUrl", "category"]
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      }
    },
    "PriceDropAlert": {
      "title": "PriceDropAlert",
      "description": "Alert subscriber of product price drops.",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "userId": { "type": ["string", "null"] },
        "targetPrice": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "triggered"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "productName", "email", "targetPrice", "status"]
    },
    "NewsletterSubscriber": {
      "title": "NewsletterSubscriber",
      "description": "An email subscriber to the SokoPlus Chronicles newsletter.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "description": "Subscriber email address" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user subscribed" },
        "userId": { "type": ["string", "null"], "description": "Authenticated user identifier, if logged in" }
      },
      "required": ["email", "createdAt"]
    },
    "Cart": {
      "title": "Cart",
      "description": "User's shopping cart synchronized to Firestore for cross-device persistence and abandoned cart emails.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Dynamic owner of the synchronized cart" },
        "email": { "type": "string", "format": "email", "description": "User's email for automated alerts" },
        "items": { "type": "array", "description": "Array of products with quantity, price, and selected customizations" },
        "isAbandonedEmailSent": { "type": "boolean", "description": "Whether an abandoned cart recovery alert was already dispatched" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Cart initialization timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last database write activity timestamp" }
      },
      "required": ["userId", "items"]
    },
    "JobOffer": {
      "title": "JobOffer",
      "description": "A job opening or career offer at SokoPlus.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "department": { "type": "string" },
        "location": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "requirements": { "type": "array" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "department", "location", "type", "description"]
    },
    "JobApplication": {
      "title": "JobApplication",
      "description": "An applicant's job application form.",
      "type": "object",
      "properties": {
        "jobId": { "type": "string" },
        "jobTitle": { "type": "string" },
        "userId": { "type": "string" },
        "applicantName": { "type": "string" },
        "applicantEmail": { "type": "string" },
        "applicantPhone": { "type": "string" },
        "resumeDetails": { "type": "string", "description": "Text details or Base64 file of resume" },
        "resumeName": { "type": "string", "description": "Original resume file name" },
        "coverLetter": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "reviewed", "shortlisted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["jobId", "jobTitle", "userId", "applicantName", "applicantEmail", "applicantPhone", "resumeDetails", "status"]
    },
    "Role": {
      "title": "Role",
      "description": "User roles and custom permission mappings.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Role display name" },
        "permissions": { "type": "array", "description": "List of active permission strings" },
        "description": { "type": "string", "description": "Brief description of role responsibilities" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "permissions"]
    },
    "AdminProfile": {
      "title": "AdminProfile",
      "description": "Platform administrator access rights and permission profiles.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "description": "Administrator email address" },
        "roleId": { "type": "string", "description": "Assigned custom role ID" },
        "roleName": { "type": "string", "description": "Assigned custom role name display" },
        "permissions": { "type": "array", "description": "Granular permissions list mapped for this admin" },
        "addedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string", "description": "Email of the super-admin who updated this profile" }
      },
      "required": ["email", "permissions"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System audit logs representing administrative and secure access modifications.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the user who performed the action" },
        "userEmail": { "type": "string", "format": "email", "description": "The email of the user who performed the action" },
        "action": { "type": "string", "description": "Action designation token e.g. create_role, delete_role, update_admin_privileges, revoke_admin_privileges" },
        "details": { "type": "string", "description": "Human-friendly details describing the precise operation" },
        "targetId": { "type": "string", "description": "The UID or key of the affected resource" },
        "targetName": { "type": "string", "description": "Readable descriptor name of the affected resource" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Serverless precise registration timestamp" }
      },
      "required": ["userId", "userEmail", "action", "details", "timestamp"]
    },
    "AdminInvitation": {
      "title": "AdminInvitation",
      "description": "Pre-authorized administrator email invitations.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "roleId": { "type": "string" },
        "roleName": { "type": "string" },
        "permissions": { "type": "array" },
        "invitedAt": { "type": "string", "format": "date-time" },
        "invitedBy": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted"] }
      },
      "required": ["email", "permissions", "status"]
    },
    "MarketingBanner": {
      "title": "MarketingBanner",
      "description": "Customizable promotional banners displayed on the Home page with active dates and style preferences.",
      "type": "object",
      "properties": {
        "text": { "type": "string", "description": "Banner content message" },
        "backgroundColor": { "type": "string", "description": "Tailwind color class or gradient setup" },
        "textColor": { "type": "string", "description": "Text style override color or class" },
        "startDate": { "type": "string", "format": "date-time", "description": "Launch timestamp" },
        "endDate": { "type": "string", "format": "date-time", "description": "Stop/expiry timestamp" },
        "active": { "type": "boolean", "description": "Whether the banner is active" },
        "actionText": { "type": "string", "description": "Call to action button label" },
        "actionUrl": { "type": "string", "description": "Target address to route users" },
        "closable": { "type": "boolean", "description": "Whether guests can dismiss the banner sessionally" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "backgroundColor", "startDate", "endDate", "active"]
    },
    "SellerProfile": {
      "title": "SellerProfile",
      "description": "Onboarded merchant account profile status and shop details.",
      "type": "object",
      "properties": {
        "shopName": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "rejectedReason": { "type": "string" }
      },
      "required": ["shopName", "description", "location", "phone", "status"]
    },
    "SharedWishlist": {
      "title": "SharedWishlist",
      "description": "A wishlist shared by a user with a unique link.",
      "type": "object",
      "properties": {
        "productIds": { "type": "array", "description": "Array of product IDs saved in the shared wishlist." },
        "ownerName": { "type": "string", "description": "The public name of the wishlist owner." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productIds"]
    }
  },
  "firestore": {
    "/marketing_banners": {
      "schema": "MarketingBanner",
      "description": "Active global promotional banners displayed on top of the Home page."
    },
    "/admin_invitations": {
      "schema": "AdminInvitation",
      "description": "Preauthorized administrator invitations pending registration."
    },
    "/audit_logs": {
      "schema": "AuditLog",
      "description": "Administrative accountability activities and RBAC authorization changes logs."
    },
    "/roles": {
      "schema": "Role",
      "description": "Custom user roles with fine-grained granular permissions."
    },
    "/admins": {
      "schema": "AdminProfile",
      "description": "Platform administrators with assigned access roles and custom overrides."
    },
    "/products": {
      "schema": "Product",
      "description": "Collection of all available items."
    },
    "/pending_products": {
      "schema": "Product",
      "description": "Collection of all submitted product listing drafts pending administrative review/clearance."
    },
    "/price_drop_alerts": {
      "schema": "PriceDropAlert",
      "description": "Alert subscriber records of product price drops."
    },
    "/orders": {
      "schema": "Order",
      "description": "Customer transactions."
    },
    "/carts": {
      "schema": "Cart",
      "description": "User shopping carts synchronized to Firestore for recovery functions."
    },
    "/users": {
      "schema": "UserProfile",
      "description": "User accounts and settings."
    },
    "/reviews": {
      "schema": "Review",
      "description": "Product ratings and comments."
    },
    "/blog": {
      "schema": "BlogPost",
      "description": "Marketing articles."
    },
    "/comments": {
      "schema": "Comment",
      "description": "Blog post comments and replies."
    },
    "/support_tickets": {
      "schema": "SupportTicket",
      "description": "Customer support requests."
    },
    "/settings": {
      "schema": "HomepageSettings",
      "description": "Administrative global website elements."
    },
    "/newsletter_subscribers": {
      "schema": "NewsletterSubscriber",
      "description": "Email addresses subscribed to SokoPlus Chronicles."
    },
    "/job_offers": {
      "schema": "JobOffer",
      "description": "Job offers and career opportunities."
    },
    "/job_applications": {
      "schema": "JobApplication",
      "description": "Job applications submitted by candidates."
    },
    "/sellers": {
      "schema": "SellerProfile",
      "description": "Registered third-party artisan or merchant profiles."
    },
    "/shared_wishlists": {
      "schema": "SharedWishlist",
      "description": "Publicly readable shared wishlists."
    }
  }
}
