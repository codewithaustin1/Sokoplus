{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A product available for sale in the e-commerce store.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Product name" },
        "description": { "type": "string", "description": "Full description of the product" },
        "price": { "type": "number", "description": "Price in KES" },
        "category": { "type": "string", "description": "Product category" },
        "images": { "type": "array", "description": "List of image URLs" },
        "stock": { "type": "integer", "description": "Available inventory" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "rating": { "type": "number", "description": "Average rating" },
        "reviewCount": { "type": "integer", "description": "Number of reviews" },
        "active": { "type": "boolean", "description": "Active status of the product" },
        "artisan": { "type": "string", "description": "The creative artisan or craftsperson behind the product" },
        "buyingPrice": { "type": "number", "description": "The internal buying cost from creator/supplier for profit calculation" }
      },
      "required": ["name", "price", "category", "stock"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order containing items and payment details.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "ID of the customer" },
        "items": { "type": "array", "description": "List of items in the order" },
        "totalAmount": { "type": "number", "description": "Final price paid" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled"], "description": "Current state of the order" },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "paid", "failed"], "description": "Payment authorization status" },
        "paymentReference": { "type": "string", "description": "Paystack transaction reference" },
        "shippingAddress": { "type": "object", "description": "Detailed shipping destination" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items", "totalAmount", "status"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Social and preference data for a registered customer.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "loyaltyPoints": { "type": "integer" },
        "wishlist": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer feedback on a specific product.",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "integer" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userId", "rating"]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "Content marketing article.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "author": { "type": "string" },
        "image": { "type": "string" },
        "tags": { "type": "array" },
        "publishedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "author"]
    },
    "Comment": {
      "title": "Comment",
      "description": "A comment or reply on a specific blog post.",
      "type": "object",
      "properties": {
        "postId": { "type": "string", "description": "ID of the associated blog post" },
        "userId": { "type": "string", "description": "User identifier who crafted the comment" },
        "userName": { "type": "string", "description": "Display name of the author" },
        "content": { "type": "string", "description": "Markdown comment text content" },
        "createdAt": { "type": "string", "format": "date-time" },
        "replies": {
          "type": "array",
          "description": "An array of responses containing id, userId, userName, content, and createdAt"
        }
      },
      "required": ["postId", "userId", "userName", "content", "replies"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer support request.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "subject": { "type": "string", "enum": ["Technical Support", "Billing/Invoices", "Order Status", "General Inquiry"] },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "in-progress", "resolved", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "subject", "message", "status"]
    },
    "HomepageSettings": {
      "title": "HomepageSettings",
      "description": "Customizable homepage settings like custom hero images.",
      "type": "object",
      "properties": {
        "heroImageUrl": { "type": "string" },
        "heroBadgeText": { "type": "string" },
        "heroHeadingText": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      }
    },
    "PriceDropAlert": {
      "title": "PriceDropAlert",
      "description": "Alert subscriber of product price drops.",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "userId": { "type": ["string", "null"] },
        "targetPrice": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "triggered"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "productName", "email", "targetPrice", "status"]
    },
    "NewsletterSubscriber": {
      "title": "NewsletterSubscriber",
      "description": "An email subscriber to the SokoPlus Chronicles newsletter.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "description": "Subscriber email address" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user subscribed" },
        "userId": { "type": ["string", "null"], "description": "Authenticated user identifier, if logged in" }
      },
      "required": ["email", "createdAt"]
    },
    "Cart": {
      "title": "Cart",
      "description": "User's shopping cart synchronized to Firestore for cross-device persistence and abandoned cart emails.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Dynamic owner of the synchronized cart" },
        "email": { "type": "string", "format": "email", "description": "User's email for automated alerts" },
        "items": { "type": "array", "description": "Array of products with quantity, price, and selected customizations" },
        "isAbandonedEmailSent": { "type": "boolean", "description": "Whether an abandoned cart recovery alert was already dispatched" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Cart initialization timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last database write activity timestamp" }
      },
      "required": ["userId", "items"]
    }
  },
  "firestore": {
    "/products": {
      "schema": "Product",
      "description": "Collection of all available items."
    },
    "/price_drop_alerts": {
      "schema": "PriceDropAlert",
      "description": "Alert subscriber records of product price drops."
    },
    "/orders": {
      "schema": "Order",
      "description": "Customer transactions."
    },
    "/carts": {
      "schema": "Cart",
      "description": "User shopping carts synchronized to Firestore for recovery functions."
    },
    "/users": {
      "schema": "UserProfile",
      "description": "User accounts and settings."
    },
    "/reviews": {
      "schema": "Review",
      "description": "Product ratings and comments."
    },
    "/blog": {
      "schema": "BlogPost",
      "description": "Marketing articles."
    },
    "/comments": {
      "schema": "Comment",
      "description": "Blog post comments and replies."
    },
    "/support_tickets": {
      "schema": "SupportTicket",
      "description": "Customer support requests."
    },
    "/settings": {
      "schema": "HomepageSettings",
      "description": "Administrative global website elements."
    },
    "/newsletter_subscribers": {
      "schema": "NewsletterSubscriber",
      "description": "Email addresses subscribed to SokoPlus Chronicles."
    }
  }
}
